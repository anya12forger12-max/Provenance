# Copy to .env and replace placeholders. Never commit a real .env.
# (This repo intentionally ships no .env.example today; this file is it.)

# ---- Build-time public value (baked into the client bundle) ----
# Only NEXT_PUBLIC_* variable referenced in the source. Used for metadataBase,
# OG cards, robots.txt and sitemap URLs. No trailing slash. Rebuild after change.
NEXT_PUBLIC_SITE_URL=https://provenance.example.com

# ---- Runtime values ----
# Host port published by docker-compose.yml; the container itself listens on 3000.
PORT=3000
# Bind address for the Node/Next server inside the container.
HOSTNAME=0.0.0.0

# ---- Build-time only, native builds outside Docker ----
# next.config.ts reads TN_DIST_DIR to override the build directory. The Dockerfile
# leaves it unset so its runtime stage can copy from the default `.next`.
# TN_DIST_DIR=.next
